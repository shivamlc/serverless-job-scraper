# Node
node_modules/
dist/
dist-scripts/
coverage/
*.tsbuildinfo
npm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# terraform/envs/*.tfvars ARE committed — no secrets in them (specs/12), they're
# the dev/uat/prod environment definitions the CI/CD pipeline reads directly.
!terraform/envs/*.tfvars
crash.log
crash.*.log
# .terraform.lock.hcl is intentionally NOT ignored — it pins provider versions
# and should be committed (Terraform's own recommendation).

# Test / build artifacts
test-results/
playwright-report/
*.zip

# scripts/scrapeLocal.ts output — real scraped data, never committed
seek-job-results.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
